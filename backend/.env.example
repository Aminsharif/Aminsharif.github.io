# ============================================================================
#  Amin Sharif — backend configuration
#  Copy this file to `.env` and edit the values. `.env` is git-ignored and
#  must never be committed or exposed.
# ============================================================================

# --- Flask ------------------------------------------------------------------
# Generate a strong value, e.g.  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# Production server (python serve.py): number of worker threads.
# THREADS=8

# Set to 1 only when a reverse proxy (nginx/caddy) terminates TLS in front of
# this app, so redirects and absolute URLs use the public https:// scheme.
# TRUST_PROXY=0

# Set to 1 only when the site is served over HTTPS.
COOKIE_SECURE=0

# --- PostgreSQL -------------------------------------------------------------
# Full connection string (recommended). Create the database first, e.g.:
#   createdb aminsharif
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aminsharif

# Alternatively, leave DATABASE_URL empty and use the parts below:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=aminsharif
# PGUSER=postgres
# PGPASSWORD=postgres

# --- Admin panel login ------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# Stronger option: store a hash instead of a plain password.
# Generate one with:  python -m backend.manage hash "your-password"
# ADMIN_PASSWORD_HASH=

# --- Optional: allow the API to be called from another origin ---------------
# Only needed if the static site is hosted separately from this backend.
# Comma-separated list, e.g. https://aminsharif.com,https://www.aminsharif.com
CORS_ORIGINS=
